{
  "name": "Helium Spike Test",
  "version": "1.1",
  "manifest_version": 3,
  "description": "Dummy extension to test off-store install and self-hosted auto-update in Helium.",
  "key": "",
  "update_url": "https://phasu21.github.io/helium-spike-test-extension/updates.xml",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Helium Spike Test" },
